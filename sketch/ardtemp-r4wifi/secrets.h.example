// Copy this file to secrets.h and fill in your values.
// secrets.h is gitignored and never committed.

#define WIFI_SSID    "your-network-ssid"
#define WIFI_PASS    "your-network-password"
#define SERVICE_HOST "laminarflow"
#define SERVICE_PORT 30700

// Identity this board reports to the service, and the key the indicator polls
// with (`board` in ~/.config/ardtemp/ardtemp.conf).
//
// MUST be unique per physical board. Two boards sharing one BOARD_ID will
// interleave their readings into a single series and share one pending-command
// slot, so alerts land on whichever board happens to POST first.
//
// Optional — the sketch defaults to "r4wifi" if this is not defined.
//#define BOARD_ID   "filament"

// Which metric the on-board 8x12 LED matrix shows:
//   'H' — relative humidity, e.g. "43%"  (filament storage)
//   'T' — temperature in whole °C, e.g. "27C"
// Does not affect what is POSTed to the service, the Modulino Pixels bar, or
// any alerting — all of those stay humidity-based.
//
// Optional — the sketch defaults to 'H' if this is not defined.
//#define DISPLAY_METRIC 'T'
